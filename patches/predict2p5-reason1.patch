+def get_reason1_embedding_with_disk_cache(task_label: str) -> torch.Tensor:
+    """Persist individual misses atomically without rewriting the 25 GB base cache."""
+    cache_file = None
+    if t5_text_embeddings_path_global is not None:
+        cache_dir = t5_text_embeddings_path_global + ".extra"
