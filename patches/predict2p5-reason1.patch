+        key = hashlib.sha256(task_label.encode("utf-8")).hexdigest()
+        cache_file = os.path.join(cache_dir, key + ".pt")
+        if os.path.exists(cache_file):
+            saved = torch.load(cache_file, map_location="cpu", weights_only=True)
+            if saved["instruction"] != task_label:
+                raise ValueError(f"Instruction mismatch in Reason1 cache: {cache_file}")
+            print(f"Loaded extra Reason1 embedding for instruction: '{task_label}'")
